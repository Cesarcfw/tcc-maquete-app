[
  {
    "id": "samahi-local",
    "type": "tab",
    "label": "SAMAHI — ESP virtual e API",
    "disabled": false,
    "info": "Sensores virtuais. Comandos HTTP do app. Sem hardware conectado."
  },
  {
    "id": "samahi-note",
    "type": "comment",
    "z": "samahi-local",
    "name": "SIMULAÇÃO · sensores a cada 2 s · controle pelo app local",
    "x": 350,
    "y": 40,
    "wires": []
  },
  {
    "id": "samahi-tick",
    "type": "inject",
    "z": "samahi-local",
    "name": "Atualizar sensores (2 s)",
    "props": [],
    "repeat": "2",
    "once": true,
    "onceDelay": "0.1",
    "x": 180,
    "y": 100,
    "wires": [["samahi-sample"]],
    "crontab": "",
    "topic": "",
    "payload": "",
    "payloadType": "date"
  },
  {
    "id": "samahi-sample",
    "type": "function",
    "z": "samahi-local",
    "name": "Leitura do ESP virtual",
    "func": "const sim = global.get('samahi'); sim.sample(); msg.payload = sim.telemetry(); return msg;",
    "outputs": 1,
    "x": 460,
    "y": 100,
    "wires": [["samahi-debug"]]
  },
  {
    "id": "samahi-debug",
    "type": "debug",
    "z": "samahi-local",
    "name": "Telemetria simulada",
    "active": false,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg",
    "x": 760,
    "y": 100,
    "wires": []
  },
  {
    "id": "samahi-telemetry-http",
    "type": "http in",
    "z": "samahi-local",
    "name": "GET telemetry",
    "url": "/api/v1/rooms/:roomId/telemetry",
    "method": "get",
    "upload": false,
    "x": 170,
    "y": 220,
    "wires": [["samahi-telemetry-fn"]]
  },
  {
    "id": "samahi-telemetry-fn",
    "type": "function",
    "z": "samahi-local",
    "name": "Consultar última leitura",
    "func": "const result = global.get('samahi').handle('telemetry', msg.req.params.roomId, msg.payload); msg.statusCode = result.status; msg.headers = {'Content-Type':'application/json', 'Cache-Control':'no-store'}; msg.payload = result.body; return msg;",
    "outputs": 1,
    "x": 460,
    "y": 220,
    "wires": [["samahi-telemetry-response"]]
  },
  {
    "id": "samahi-telemetry-response",
    "type": "http response",
    "z": "samahi-local",
    "name": "Resposta JSON",
    "statusCode": "",
    "headers": {},
    "x": 760,
    "y": 220,
    "wires": []
  },
  {
    "id": "samahi-commands-http",
    "type": "http in",
    "z": "samahi-local",
    "name": "POST commands",
    "url": "/api/v1/rooms/:roomId/commands",
    "method": "post",
    "upload": false,
    "x": 170,
    "y": 320,
    "wires": [["samahi-commands-fn"]]
  },
  {
    "id": "samahi-commands-fn",
    "type": "function",
    "z": "samahi-local",
    "name": "Validar → aplicar → confirmar",
    "func": "const result = global.get('samahi').handle('commands', msg.req.params.roomId, msg.payload); msg.statusCode = result.status; msg.headers = {'Content-Type':'application/json', 'Cache-Control':'no-store'}; msg.payload = result.body; return msg;",
    "outputs": 1,
    "x": 460,
    "y": 320,
    "wires": [["samahi-commands-response"]]
  },
  {
    "id": "samahi-commands-response",
