[
  {
    "id": "samahi-physical-api",
    "type": "tab",
    "label": "SAMAHI — API do ESP fisico",
    "disabled": false,
    "info": "Backend autenticado -> API local -> UDP e ACK do ESP. Desativar API virtual para evitar rotas duplicadas."
  },
  {
    "id": "samahi-physical-telemetry-http",
    "type": "http in",
    "z": "samahi-physical-api",
    "name": "GET telemetry",
    "url": "/api/v1/rooms/:roomId/telemetry",
    "method": "get",
    "upload": false,
    "x": 200,
    "y": 100,
    "wires": [
      [
        "samahi-physical-telemetry-fn"
      ]
    ]
  },
  {
    "id": "samahi-physical-telemetry-fn",
    "type": "function",
    "z": "samahi-physical-api",
    "name": "Consultar ponte fisica",
    "func": "const gateway=global.get('samahiPhysical'); const result=gateway ? await gateway.handle('telemetry',msg.req.params.roomId,msg.payload) : {status:503,body:{error:'Ponte fisica nao carregada. Reinicie o Node-RED.'}}; msg.statusCode=result.status; msg.headers={'Content-Type':'application/json','Cache-Control':'no-store'};msg.payload=result.body;return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 100,
    "wires": [
      [
        "samahi-physical-telemetry-response"
      ]
    ]
  },
  {
    "id": "samahi-physical-telemetry-response",
    "type": "http response",
    "z": "samahi-physical-api",
    "name": "Resposta fisica JSON",
    "statusCode": "",
    "headers": {},
    "x": 840,
    "y": 100,
    "wires": []
  },
