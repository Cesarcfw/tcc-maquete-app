{
  "openapi": "3.1.1",
  "info": {
    "title": "SAMAHI — Node-RED interno",
    "version": "1.0.0",
    "description": "Protocolo de telemetria 1 usado pelo app 0.7.0. Leitura e comandos são usados no modo físico ou simulado. Cenários e reset são exclusivos do simulador. A API interna e o editor ficam em loopback."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:1880",
      "description": "Apenas loopback do computador"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Dispositivo",
      "description": "Leitura e comandos no gateway físico ou simulado."
    },
    {
      "name": "Dispositivo virtual",
      "description": "Cenários e reset do simulador."
    }
  ],
  "paths": {
    "/api/v1/rooms/{roomId}/telemetry": {
      "get": {
        "operationId": "getVirtualTelemetry",
        "summary": "Consultar leitura do dispositivo",
        "description": "Endpoint interno sem autenticação; manter loopback. roomId atendido: quarto-01. Reset preserva luz somente na instância com storage. Leitura stale bloqueia comando; erro de gravação não confirma luz.",
        "tags": [
          "Dispositivo"
        ],
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Telemetry"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ausente ou existência ocultada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível, rede ou persistência de luz.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/rooms/{roomId}/commands": {
      "post": {
        "operationId": "sendVirtualCommand",
        "summary": "Aplicar comando na origem ativa e aguardar confirmação",
        "description": "Endpoint interno sem autenticação; manter loopback. roomId atendido: quarto-01. Reset preserva luz somente na instância com storage. Leitura stale bloqueia comando; erro de gravação não confirma luz.",
        "tags": [
          "Dispositivo"
        ],
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Conteúdo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ausente ou existência ocultada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflito, quarto inativo, comando já registrado sem confirmação ou leitura antiga no dispositivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Serviço indisponível, rede ou persistência de luz.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Timeout do dispositivo ou ausência de ACK físico.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/rooms/{roomId}/simulation": {
      "post": {
        "operationId": "changeSimulation",
        "summary": "Alterar cenário ou sensores virtuais",
        "description": "Endpoint interno sem autenticação; manter loopback. roomId atendido: quarto-01. Reset preserva luz somente na instância com storage. Leitura stale bloqueia comando; erro de gravação não confirma luz.",
        "tags": [
          "Dispositivo virtual"
        ],
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Telemetry"
                }
              }
            }
          },
          "400": {
            "description": "Conteúdo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ausente ou existência ocultada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/rooms/{roomId}/reset": {
      "post": {
        "operationId": "resetVirtualDevice",
        "summary": "Reiniciar estado virtual",
        "description": "Endpoint interno sem autenticação; manter loopback. roomId atendido: quarto-01. Reset preserva luz somente na instância com storage. Leitura stale bloqueia comando; erro de gravação não confirma luz.",
        "tags": [
          "Dispositivo virtual"
        ],
        "responses": {
          "200": {
            "description": "Sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Telemetry"
                }
              }
            }
          },
          "400": {
            "description": "Conteúdo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Recurso ausente ou existência ocultada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LightingSchedule": {
        "type": "object",
        "properties": {
          "timeZone": {
            "type": "string",
            "const": "America/Sao_Paulo"
          },
          "dayStart": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "nightStart": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "dayIntensity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "nightIntensity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "timeZone",
          "dayStart",
          "nightStart",
          "dayIntensity",
          "nightIntensity"
        ],
        "description": "Horários distintos; dia inclui início e termina no início da noite. Intervalo pode atravessar meia-noite. A desigualdade dos horários é validada em runtime."
      },
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "light",
                "type": "string"
              },
              "on": {
                "type": "boolean"
              },
              "intensity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "kind",
              "on",
              "intensity"
            ],
            "description": "on deve ser exatamente intensity > 0; manual pausa agenda."
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "lightingSchedule",
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "schedule": {
                "$ref": "#/components/schemas/LightingSchedule"
              }
            },
            "required": [
              "kind",
              "enabled",
              "schedule"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "indicator",
                "type": "string"
              },
              "color": {
                "type": "string",
                "enum": [
                  "red",
                  "yellow",
                  "green",
                  "blue",
                  "off"
                ]
              }
            },
            "required": [
              "kind",
              "color"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "acknowledgeGas",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "description": "Reconhece detecção sem eliminar gás. Autorização sensors:read no backend."
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Telemetry": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "telemetry"
          },
          "protocolVersion": {
            "type": "integer",
            "const": 1
          },
          "roomId": {
            "type": "string"
          },
          "deviceId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "node-red-simulator",
              "esp32-physical"
            ]
          },
          "sampledAt": {
            "type": "string",
            "format": "date-time"
          },
          "sampleAgeMs": {
            "type": "number",
            "minimum": 0
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "temperatureC": {
            "type": [
              "number",
              "null"
            ]
          },
          "temperatureValid": {
            "type": "boolean"
          },
          "humidityPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "humidityValid": {
            "type": "boolean"
          },
          "gasRawAdc": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 4095
          },
          "gasStatus": {
            "type": "string",
            "enum": [
              "clear",
              "detected",
              "unavailable"
            ]
          },
          "gasAcknowledged": {
            "type": "boolean"
          },
          "buzzerOn": {
            "type": "boolean"
          },
          "ldrRawAdc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "dark": {
            "type": "boolean"
          },
          "lightOn": {
            "type": "boolean"
          },
          "lightIntensityPercent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "lastPositiveIntensity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "lightMode": {
            "type": "string",
            "enum": [
              "manual",
              "scheduled"
            ]
          },
          "lightingSchedule": {
            "$ref": "#/components/schemas/LightingSchedule"
          },
          "lightingPeriod": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "day",
              "night",
              null
            ]
          },
          "indicatorColor": {
            "type": "string",
            "enum": [
              "red",
              "orange",
              "yellow",
              "green",
              "blue",
              "off"
            ]
          },
          "uptimeMs": {
            "type": "number",
            "minimum": 0
          },
          "adcBits": {
            "type": "integer",
            "const": 12
          },
          "gasThresholdAdc": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4094
          },
          "darkThresholdAdc": {
            "type": "integer",
            "const": 1500
          },
          "scenario": {
            "type": "string",
            "enum": [
              "normal",
              "offline",
              "stale",
              "timeout"
            ]
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "network": {
                "type": "boolean"
              },
              "pwm": {
                "type": "boolean"
              },
              "manchester": {
                "type": "boolean"
              },
              "manchesterSimulatedOnly": {
                "type": "boolean"
              },
              "hardware": {
                "type": "boolean"
              },
              "scheduledLighting": {
                "type": "boolean"
              }
            },
            "required": [
              "network",
              "pwm",
              "manchester",
              "manchesterSimulatedOnly",
              "hardware",
              "scheduledLighting"
            ]
          },
          "gasClearThresholdAdc": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4094
          },
          "gasAlarmActive": {
            "type": "boolean"
          },
          "gasAlarmFault": {
            "type": "boolean"
          },
          "gasMonitoringConfigured": {
            "type": "boolean"
          },
          "rgbBlinking": {
            "type": "boolean"
          },
          "rgbAlarmFallback": {
            "type": "boolean"
          },
          "rgbVisibleColor": {
            "type": "string",
            "enum": [
              "red",
              "yellow",
              "green",
              "blue",
              "off",
              "unknown"
            ]
          },
          "lightingScheduleError": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "protocolVersion",
          "roomId",
          "deviceId",
          "source",
          "sampledAt",
          "sampleAgeMs",
          "sequence",
          "temperatureC",
          "temperatureValid",
          "humidityPercent",
          "humidityValid",
          "gasRawAdc",
          "gasStatus",
          "gasAcknowledged",
          "buzzerOn",
          "lightOn",
          "lightIntensityPercent",
          "lastPositiveIntensity",
          "lightMode",
          "lightingSchedule",
          "lightingPeriod",
          "indicatorColor",
          "uptimeMs",
          "gasThresholdAdc",
          "capabilities"
        ],
        "description": " Origem fisica nao usa fallback simulado. Valores DHT invalidos sao null; gasAlarmActive e estado latched do firmware e nao comparacao ADC instantanea. sampledAt na ponte fisica e o instante de recepcao no gateway."
      },
      "CommandRequest": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,80}$"
          },
          "command": {
            "$ref": "#/components/schemas/Command"
          }
        },
        "required": [
          "commandId",
          "command"
        ],
        "description": "Node-RED atual aceita somente letras/números/hífen no ID. Use esse subconjunto para interoperabilidade. Não há retry automático seguro de comando unconfirmed."
      },
      "CommandResult": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "command_result"
          },
          "commandId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "applied_in_simulator",
              "applied_in_hardware",
              "acknowledged_in_gateway"
            ]
          },
          "telemetry": {
            "$ref": "#/components/schemas/Telemetry"
          },
          "confirmationScope": {
            "type": "string",
            "enum": [
              "firmware_ack",
              "app-only"
            ]
          },
          "wireCommandId": {
            "type": "string",
            "description": "ID UDP correlacionado ao ACK, somente em confirmacao fisica."
          }
        },
        "required": [
          "type",
          "commandId",
          "status",
          "telemetry"
        ]
      },
      "SimulationInput": {
        "type": "object",
        "properties": {
          "temperatureC": {
            "type": "number",
            "minimum": -40,
            "maximum": 80
          },
          "humidityPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "gasRawAdc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "ldrRawAdc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "gasUnavailable": {
            "type": "boolean"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "normal",
              "offline",
              "stale",
              "timeout"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Atualização parcial de entradas virtuais. Afeta todos os clientes da instância."
      }
    }
  }
}
